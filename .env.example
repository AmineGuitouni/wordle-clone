# MongoDB connection (Atlas or local). The database is created on first write.
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB="guess-the-word"

# Secret used to sign session cookies. Generate one with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""

# Shared secret that authorises the daily "new word" webhook (see README).
WEBHOOK_SECRET_KEY=""

# Vercel only: set to the same value as WEBHOOK_SECRET_KEY. Vercel Cron (vercel.json) sends it as a bearer token.
# CRON_SECRET=""

# Redis connection for caching, rate limiting and proof-of-work replay protection.
# Optional: without it a per-process in-memory cache is used (fine locally, not shared between instances).
# Use rediss:// for TLS (managed services such as Upstash or Redis Cloud).
# REDIS_URL="redis://127.0.0.1:6379"

# Key prefix for everything stored in Redis (default "gtw"); lets staging and production share one Redis.
# CACHE_NAMESPACE="gtw"

# Base difficulty (leading zero bits) of the proof-of-work challenge for new browsers, 0-28 (default 16).
# POW_DIFFICULTY_BITS="16"

# Required for production runs outside Vercel (`npm start`, Docker, a VPS); Vercel sets this automatically.
# Without it Auth.js rejects sign-in with an "UntrustedHost" error.
# AUTH_TRUST_HOST="true"

# Public URL of the deployed site, used for absolute Open Graph / link-preview URLs (optional on Vercel).
# NEXT_PUBLIC_SITE_URL="https://your-app.example.com"
